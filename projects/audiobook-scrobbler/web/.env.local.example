# Supabase (server-side only; service role bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single shared bearer token used by the Android app and the PWA.
# Generate with: openssl rand -hex 32
API_TOKEN=

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Hardcover personal access token (https://hardcover.app/account/api).
# Leave blank to run without Hardcover; HARDCOVER_DRY_RUN=true logs the
# mutations it would send without sending them.
HARDCOVER_TOKEN=
HARDCOVER_DRY_RUN=true
